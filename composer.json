{
    "name": "phatnt93/phalcon-validation",
    "description": "High-performance, expressive PHP data validation and sanitization library for Phalcon Framework v5 and v6, inspired by GUMP. Features 80+ validators, 17 filters, nested wildcard arrays, file upload validation, and Phalcon MVC Model ORM integration.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Phat Nguyen",
            "email": "phatnt93@gmail.com"
        }
    ],
    "keywords": [
        "phalcon",
        "phalcon5",
        "phalcon6",
        "cphalcon",
        "validation",
        "validator",
        "filter",
        "filtering",
        "sanitization",
        "sanitizer",
        "gump",
        "request-validation",
        "form-validation",
        "data-validation",
        "file-upload-validation",
        "nested-validation",
        "wildcard-validation",
        "php",
        "php8",
        "psr-4"
    ],
    "homepage": "https://github.com/phatnt93/phalcon-validation",
    "support": {
        "issues": "https://github.com/phatnt93/phalcon-validation/issues",
        "source": "https://github.com/phatnt93/phalcon-validation",
        "docs": "https://github.com/phatnt93/phalcon-validation#readme"
    },
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4"
    },
    "suggest": {
        "ext-phalcon": "Required to use Phalcon native C validators, filters and DI service provider (^5.0 || ^6.0)"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "PhalconValidation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhalconValidation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "readme": "README.md",
    "extra": {
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    }
}
